{
  "name": "HUSBA Admin",
  "short_name": "HUSBA Admin",
  "description": "Private mobile workspace for managing HUSBA Beads.",
  "id": "/admin/",
  "start_url": "/admin/",
  "scope": "/admin/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#F8F5F1",
  "theme_color": "#171515",
  "shortcuts": [
    { "name": "Products", "short_name": "Products", "url": "/admin/#products", "icons": [{ "src": "/admin/icons/admin-192.png", "sizes": "192x192" }] },
    { "name": "Enquiries", "short_name": "Enquiries", "url": "/admin/#enquiries", "icons": [{ "src": "/admin/icons/admin-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "/admin/icons/admin-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/admin/icons/admin-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
